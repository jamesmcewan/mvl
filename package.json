{
  "name": "mvl",
  "version": "8.4.0",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "format:check": "prettier --check  .",
    "format": "prettier --write .",
    "lint": "eslint src/**/*.ts *.mjs *.cjs",
    "lint-staged": "lint-staged",
    "lint:fix": "eslint src/**/*.ts *.mjs *.cjs --fix",
    "prepare": "is-ci || husky",
    "preview": "astro preview",
    "start": "astro dev",
    "test": "vitest",
    "update-dependencies": "bunx @astrojs/upgrade;bun update"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.37.0",
    "@flydotio/dockerfile": "^0.7.10",
    "@tailwindcss/postcss": "^4.1.14",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bun": "^1.3.0",
    "@types/eslint__eslintrc": "^3.3.0",
    "@types/node": "^24.7.2",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "astro": "^5.14.4",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^16.2.4",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.10",
    "@astrojs/node": "^9.4.6",
    "@astrojs/vercel": "^8.2.9",
    "solid-js": "^1.9.9"
  },
  "lint-staged": {
    "*.md|*.html|*.json|*.astro|*.ts|*.tsx|*.mjs|*.cjs": [
      "prettier --write"
    ],
    "*.ts|.tsx|.cjs|*.mjs": [
      "bun run lint"
    ]
  }
}
